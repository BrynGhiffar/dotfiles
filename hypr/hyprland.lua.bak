-- ~/.config/hypr/hyprland.lua

-- Programs
local terminal = "ghostty"
local fileManager = "launch_kitty explorer yazi"
local menu = "launch_kitty fzfapp fzfapp"
local mainMod = "SUPER"

-- Monitors
hl.monitor({ output = "DP-3", mode = "1920x1080@180", position = "0x0", scale = 1 })
hl.monitor({ output = "HDMI-A-1", mode = "1920x1080@60", position = "1920x0", scale = 1 })

-- Environment Variables
hl.env("XCURSOR_SIZE", "24")
hl.env("SSH_AUTH_SOCK", (os.getenv("XDG_RUNTIME_DIR") or "") .. "/ssh-agent.socket")

-- Autostart (replaces exec-once)
hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("nohup wpdm >/dev/null 2>&1 &")
    hl.exec_cmd("barbar")
    hl.exec_cmd("/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1")
    hl.exec_cmd('eval "$(ssh-agent -s)"')
end)

-- General Configuration Options
hl.config({
    input = {
        kb_layout = "us",
        kb_variant = "",
        kb_model = "",
        kb_options = "",
        kb_rules = "",
        follow_mouse = 1,
        touchpad = {
            natural_scroll = false,
        },
        sensitivity = 0,
    },

    general = {
        gaps_in = 5,
        gaps_out = { 0, 5, 5, 5 },
        border_size = 1,
        col = {
            active_border = "rgba(33ccffee) rgba(00ff99ee) 45deg",
            inactive_border = "rgba(595959aa)",
        },
        layout = "dwindle",
        allow_tearing = false,
    },

    decoration = {
        rounding = 10,
        blur = {
            enabled = true,
            size = 5,
            passes = 2,
        },
    },

    animations = {
        enabled = true,
    },

    dwindle = {
        preserve_split = true,
    },

    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo = true,
        mouse_move_enables_dpms = true,
        key_press_enables_dpms = true,
    },
})

-- Curves & Animations
hl.curve("myBezier", { type = "bezier", points = { { 0.05, 0.9 }, { 0.1, 1.0 } } })

hl.animation({ leaf = "windows", enabled = true, speed = 8, curve = "default", style = "slide 100%", bezier = "myBezier" })
hl.animation({ leaf = "windowsOut", enabled = true, speed = 7, curve = "default", style = "slide 100%", bezier = "myBezier" })
hl.animation({ leaf = "border", enabled = true, speed = 10, curve = "default", bezier = "myBezier" })
hl.animation({ leaf = "borderangle", enabled = true, speed = 8, curve = "default", bezier = "myBezier" })
hl.animation({ leaf = "fade", enabled = true, speed = 7, curve = "default", bezier = "myBezier" })
hl.animation({ leaf = "workspaces", enabled = true, speed = 8, curve = "default", style = "slidefade 20%" })

-- Window Rules
hl.window_rule({ match = { class = "fzfwallpaper" }, pin = true, stay_focused = true, float = true, center = true, size = "1200 400" })
hl.window_rule({ match = { class = "explorer" }, pin = true, stay_focused = true, float = true, center = true, size = "1200 600" })
hl.window_rule({ match = { class = "fzfapp" }, pin = true, stay_focused = true, float = true, center = true, size = "400 300" })
hl.window_rule({ match = { title = "wgpu_cube" }, pin = true, float = true, move = "1480 40", size = "400 400" })

-- Workspace Rules
for i = 1, 3 do
    hl.workspace_rule({ workspace = tostring(i), monitor = "DP-3", persistent = true })
end
for i = 4, 6 do
    hl.workspace_rule({ workspace = tostring(i), monitor = "HDMI-A-1", persistent = true })
end

-- Key Bindings
hl.bind(mainMod .. " + RETURN", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + W", hl.dsp.window.close())
hl.bind(mainMod .. " + M", hl.dsp.exec_cmd("launch_kitty fzfwallpaper hypr_wallpaper"))
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + T", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + SPACE", hl.dsp.exec_cmd(menu))

-- Note: Fixed the `$mainMode` typo from your original config to `mainMod`
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen({ mode = 1 }))
hl.bind(mainMod .. " + SHIFT + F", hl.dsp.window.fullscreen({ mode = 2 }))
hl.bind(mainMod .. " + Y", hl.dsp.exec_cmd('notify-send "Date: $(date)" --expire-time=2500'))

-- Volume (repeating flag replaces `binde`)
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 7%+"), { repeating = true })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 7%-"), { repeating = true })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"))

-- Screenshot & Color Picker
hl.bind(mainMod .. " + CTRL + S", hl.dsp.exec_cmd('grim -g "$(select-region)" - | wl-copy && notify-send "Screenshot" "Copied to clipboard"', { raw = true }))
hl.bind(mainMod .. " + SHIFT + C", hl.dsp.exec_cmd("hyprpicker -a"))
hl.bind(mainMod .. " + Q", hl.dsp.exec_cmd("/home/bryn/dotfiles/wlogout/scripts/run.sh"))

-- Move Focus
hl.bind(mainMod .. " + h", hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + l", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + k", hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + j", hl.dsp.focus({ direction = "down" }))

-- Switch & Move Workspaces (1-3, a/s/d -> 4-6, 7-0 -> 7-10)
local ws_keys = {
    { key = "1", ws = 1 },
    { key = "2", ws = 2 },
    { key = "3", ws = 3 },
    { key = "a", ws = 4 },
    { key = "s", ws = 5 },
    { key = "d", ws = 6 },
    { key = "7", ws = 7 },
    { key = "8", ws = 8 },
    { key = "9", ws = 9 },
    { key = "0", ws = 10 },
}

for _, item in ipairs(ws_keys) do
    hl.bind(mainMod .. " + " .. item.key, hl.dsp.focus({ workspace = item.ws }))
    hl.bind(mainMod .. " + SHIFT + " .. item.key, hl.dsp.window.move({ workspace = item.ws }))
end

-- Mouse Bindings
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up", hl.dsp.focus({ workspace = "e-1" }))
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })
